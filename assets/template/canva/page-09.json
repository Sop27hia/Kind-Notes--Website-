   "opacity": 1,
   "isLocked": false,
   "type": "text",
   "textRegions": [
    {
     "characters": "Happy Birthday, my love! Watching you grow into the amazing person you are today has been such a joy. I\u2019m so proud of everything you\u2019ve become and everything that\u2019s still ahead.\n \u2013 Mom \n",
     "formatting": {
      "fontSize": 13.693915435330409,
      "fontWeight": "normal",
