   "opacity": 1,
   "isLocked": false,
   "type": "text",
   "textRegions": [
    {
     "characters": "You make everyone\u2019s world brighter just by being in it. I hope today reminds you how loved you truly are.\n \u2013 Sister",
     "formatting": {
      "fontSize": 13.69391543533041,
      "fontWeight": "normal",
