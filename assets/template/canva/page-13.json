  },
  {
   "id": "LBb2GW3D7t8NVpWC",
   "top": 755.1284493581537,
   "left": 104.073825449152,
   "width": 284.6867505560234,
   "height": 245.63013351725493,
   "rotation": 0,
   "opacity": 1,
   "isLocked": false,
   "type": "text",
   "textRegions": [
    {
     "characters": "The Notebook is a romantic drama based on Nicholas Sparks\u2019 novel. It tells the story of Noah Calhoun and Allie Hamilton, two young lovers from very different social backgrounds, and follows their journey through love, separation, and enduring devotion. They fall in love one summer, but circumstances and family expectations force them apart. Noah writes letters to Allie, but she never receives them, and years later, she becomes engaged to another man. When they reunite, their love is reignited, showing that true connection can survive time and obstacles.",
     "formatting": {
      "fontSize": 13.99044617707732,
      "fontWeight": "normal",
      "fontStyle": "italic",
      "color": "#ffffff",
      "textAlign": "justify",
      "decoration": "none",
      "strikethrough": "none",
      "link": "",
      "listMarker": "none",
      "listLevel": 0,
      "lineHeight": 1.37,
      "letterSpacing": -0.022,
      "fontRef": "YALBszUSD-E,0"
     }
    }
   ],
   "locator_id": "PByscsRTdFncqXFD-LBb2GW3D7t8NVpWC"
  },
  {
   "id": "LBmhbfc39G74m80D",
   "top": 755.1284493581536,
   "left": 410.5168049218415,
   "width": 284.68675055602336,
   "height": 264.7077111608978,
   "rotation": 0,
   "opacity": 1,
   "isLocked": false,
   "type": "text",
   "textRegions": [
    {
     "characters": "The story alternates between their youthful romance and their lives as an elderly couple, emphasizing the lifelong impact of love and memory. Director Nick Cassavetes wanted the audience to understand that love is not just about passion but also about patience, forgiveness, and commitment. The film shows that love can transcend social differences, misunderstandings, and life\u2019s challenges, and that expressing feelings honestly is essential. Ultimately, the message of the movie is that true love may not be easy or perfect, but it is worth fighting for every day, and life is too short not to cherish it.",
     "formatting": {
      "fontSize": 13.99044617707732,
      "fontWeight": "normal",
