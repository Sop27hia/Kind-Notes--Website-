  },
  {
   "id": "LBzHdXzrDjnfx8l7",
   "top": 469.81354219846077,
   "left": 80.88188976377961,
   "width": 269.93407567044017,
   "height": 99.53461417865978,
   "rotation": 0,
   "opacity": 1,
   "isLocked": false,
   "type": "text",
   "textRegions": [
    {
     "characters": "3. Montmartre & Sacr\u00e9-C\u0153ur\n Montmartre is the artsy heart of Paris. Wander through its winding streets, admire the colorful street art, and don\u2019t miss the view from the steps of Sacr\u00e9-C\u0153ur. Bonus: grab a crepe from a local stall and enjoy it while people-watching!",
     "formatting": {
      "fontSize": 12.470197114824577,
      "fontWeight": "normal",
