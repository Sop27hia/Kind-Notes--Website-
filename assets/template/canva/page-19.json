   "type": "text",
   "textRegions": [
    {
     "characters": "4. Palais-Royal & Jardin du Palais-Royal\n For a more peaceful escape, visit the beautiful gardens and the chic columns of Palais-Royal. It\u2019s a perfect spot for photos or a quiet moment away from the busy city streets.",
     "formatting": {
      "fontSize": 12.470197114824577,
