      "fontRef": "YAGL3riVrnU,0"
     }
    }
   ],
   "locator_id": "PBbXXVrhk4X1Ytnb-LB91xrc6nlh9LJxC"
  },
  {
   "id": "LBLtDTRQtgdx7ZKr",
   "top": 264.9900089703887,
   "left": 487.61112013926623,
   "width": 234.6986578256359,
   "height": 105.8174896252447,
   "rotation": 0,
   "opacity": 1,
   "isLocked": false,
   "type": "text",
   "textRegions": [
    {
     "characters": "Fresh blooms make everything better. She adores colorful bouquets, delicate scents, and the little joy flowers bring to any space. They\u2019re her go-to for a happy, bright mood.",
     "formatting": {
      "fontSize": 15.739412368351015,
      "fontWeight": "normal",
      "fontStyle": "normal",
      "color": "#2e2e2e",
      "textAlign": "justify",
      "decoration": "none",
      "strikethrough": "none",
      "link": "",
      "listMarker": "none",
      "listLevel": 0,
      "lineHeight": 1.4,
      "letterSpacing": -0.035,
      "fontRef": "YAGL3riVrnU,0"
     }
    }
   ],
   "locator_id": "PBbXXVrhk4X1Ytnb-LBLtDTRQtgdx7ZKr"
  },
  {
   "id": "LBMG0mp7R8LBsz2D",
   "top": 421.5099395496086,
   "left": 100.46160506280333,
   "width": 234.6986578256359,
   "height": 114.65579808245515,
   "rotation": 0,
   "opacity": 1,
   "isLocked": false,
   "type": "text",
   "textRegions": [
    {
     "characters": "Music is her favorite form of art. It tells stories and translates feelings and thoughts in ways words never can. It inspires her. It might be her favourite thing ever!",
     "formatting": {
      "fontSize": 16.950108456846706,
      "fontWeight": "normal",
      "fontStyle": "normal",
      "color": "#2e2e2e",
      "textAlign": "justify",
      "decoration": "none",
      "strikethrough": "none",
      "link": "",
      "listMarker": "none",
      "listLevel": 0,
      "lineHeight": 1.4,
      "letterSpacing": -0.035,
      "fontRef": "YAGL3riVrnU,0"
     }
    }
   ],
   "locator_id": "PBbXXVrhk4X1Ytnb-LBMG0mp7R8LBsz2D"
  },
  {
   "id": "LBnQfRf7cY80FKXP",
   "top": 713.984171925055,
   "left": 469.6510794284489,
   "width": 234.6986578256359,
   "height": 105.8174896252447,
   "rotation": 0,
   "opacity": 1,
   "isLocked": false,
   "type": "text",
   "textRegions": [
    {
     "characters": "New cities, cultures, and adventures are her ultimate thrill. Whether it\u2019s wandering cobblestone streets in Europe or relaxing on a sunny beach, travel fills her life with memories she\u2019ll never forget.",
     "formatting": {
      "fontSize": 15.739412368351015,
      "fontWeight": "normal",
      "fontStyle": "normal",
      "color": "#2e2e2e",
      "textAlign": "justify",
      "decoration": "none",
      "strikethrough": "none",
      "link": "",
      "listMarker": "none",
      "listLevel": 0,
      "lineHeight": 1.4,
      "letterSpacing": -0.035,
      "fontRef": "YAGL3riVrnU,0"
     }
    }
   ],
