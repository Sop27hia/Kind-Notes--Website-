   "opacity": 1,
   "isLocked": false,
   "type": "text",
   "textRegions": [
    {
     "characters": "Nothing beats a big plate of creamy, cheesy pasta, it\u2019s her ultimate comfort food! Whether it\u2019s a cozy dinner at home or a fancy Italian restaurant, pasta always makes her smile.",
     "formatting": {
      "fontSize": 15.739412368351015,
      "fontWeight": "normal",
      "fontStyle": "normal",
      "color": "#2e2e2e",
      "textAlign": "justify",
